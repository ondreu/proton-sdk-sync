{
    "name": "proton-sdk-sync",
    "version": "1.2.0",
    "description": "End-to-end encrypted two-way sync between your vault and Proton Drive, with three-way conflict detection. Includes a headless daemon for Linux servers.",
    "main": "main.js",
    "private": true,
    "license": "GPL-3.0-or-later",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc --noEmit && node esbuild.config.mjs production",
        "check-types": "tsc --noEmit",
        "test": "node scripts/test.mjs",
        "lint": "eslint --max-warnings 0",
        "check:manifest": "node scripts/check-manifest.mjs"
    },
    "dependencies": {
        "@protontech/crypto": "2.2.0",
        "@protontech/drive-sdk": "0.23.0",
        "core-js": "^3.51.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/node": "^22.20.4",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "eslint-plugin-obsidianmd": "^0.6.0",
        "obsidian": "^1.14.4",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.0"
    },
    "homepage": "https://github.com/ondreu/proton-sdk-sync",
    "author": "ondreu",
    "overrides": {
        "moment": "^2.31.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ondreu/proton-sdk-sync.git"
    }
}
